# Shared folder on the QNAP, as the NAS itself sees it.
# Container Station shows the path under Shared Folders.
MEDIA_PATH=/share/Media

# Owner of new NFO, cover, and trailer files. On many QNAPs the admin
# user is 1000 and the everyone group is 100. Leave both at 0 to run as root.
PUID=1000
PGID=100

# Port on the NAS for the web page.
PORT=5000
